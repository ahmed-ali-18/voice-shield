{
  "manifest_version": 3,
  "name": "VoiceShield — Camera-Assisted Voice Isolation",
  "version": "0.8.0",
  "description": "Privacy-preserving, on-device microphone gating using facial landmarks + voice activity detection.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VoiceShield"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/integrations/google-meet/meet-bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/utils/*.js",
        "src/camera/*.js",
        "src/vision/*.js",
        "src/audio/*.js",
        "src/vad/*.js",
        "src/decision/*.js",
        "src/integrations/google-meet/*.js",
        "vendor/mediapipe/*",
        "vendor/mediapipe/wasm/*",
        "vendor/mediapipe/models/*"
      ],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
